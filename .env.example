# GitHub Configuration (Server-Side Only - never exposed to client bundles)
GITHUB_USERNAME=your_github_username_here
GITHUB_TOKEN=your_github_personal_access_token_here

# Base URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB Configuration (optional for portfolio cache / contact messages)
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio_db

# EmailJS Configuration (Contact Form - https://emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_AUTO_REPLY_TEMPLATE_ID=your_auto_reply_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
